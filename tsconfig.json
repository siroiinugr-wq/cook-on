{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "types": ["vite/client"],
    "paths": { "@shared/*": ["./functions/src/shared/*"] }
  },
  "include": ["src", "functions/src/shared"],
  "exclude": ["**/*.test.ts"]
}
